# Production build configuration (Hostinger static deployment).
#
# Vite inlines VITE_* variables at BUILD time, so this file must be present
# and correct BEFORE running `npm run build`. Changing it after a build has no
# effect on an already-generated dist/.
#
# Public configuration only — never put a service-role key, JWT secret,
# database credential or admin password in a VITE_* variable.
VITE_API_URL=https://api.linkeye.support
