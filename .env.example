# Base URL of the LinkEye documentation backend (linkeye_back).
# Used by the admin dashboard at /admin and by the public portal, which reads
# its published documentation from this backend.
#
# Public configuration only. Never put a service-role key, JWT secret, database
# credential or admin password in a VITE_* variable: everything prefixed VITE_
# is inlined into the JavaScript bundle and is readable by anyone.
#
# Through Cloudflare Tunnel, set this to the API's public hostname and rebuild
# (Vite inlines it at build time; a dev server restart is enough in dev):
#   VITE_API_URL=https://YOUR-CLOUDFLARE-BACKEND-URL.trycloudflare.com
VITE_API_URL=http://localhost:4000
